{
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 600000,
  "editorMode": "normal",
  "effortLevel": "medium",
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": false,
    "clangd-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "theme-examples@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": false
  },
  "model": "claude-opus-5-5",
  "outputStyle": "ASD-STE100",
  "permissions": {
    "allow": [
      "mcp__ccd_session_mgmt__archive_session"
    ]
  },
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "bash \"$HOME/.claude/statusline-command.sh\"",
    "type": "command"
  },
  "theme": "auto",
  "tui": "fullscreen"
}
